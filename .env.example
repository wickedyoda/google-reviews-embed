# ---- required -------------------------------------------------------------
# Server-side only. Never expose this in the browser or commit it.
GOOGLE_MAPS_API_KEY=your_key_here

# Business registry (see businesses.example.json)
BUSINESSES_FILE=businesses.json

# ---- optional -------------------------------------------------------------
PORT=8787
CACHE_FILE=data/reviews-cache.json
# Cache lifetime. Google allows up to 30 days; 12h is a sensible default.
CACHE_TTL_SECONDS=43200
# How long to keep serving stale reviews if Google is unavailable.
CACHE_MAX_STALE_SECONDS=604800
# Comma-separated list of origins allowed to call /api/reviews cross-site.
# Empty = same-origin only (safest for a widget served from your own domain).
ALLOWED_ORIGIN=
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_MS=8000
# Refuse arbitrary ?place= ids unless explicitly enabled (quota protection).
ALLOW_ANY_PLACE=0
# Optional defaults applied to every business unless it overrides them.
LANGUAGE=
REGION=
